# Database (PostgreSQL). Voorbeeld voor lokaal:
DATABASE_URL=postgres://mep:mep@localhost:5432/mep
# Publieke URL van de beheeromgeving (voor inloglinks)
ADMIN_URL=http://localhost:3000
# E-mail: "console" print links in de terminal; "resend" verstuurt echt (later)
MAIL_DRIVER=console
MAIL_FROM="Mis en place <no-reply@example.nl>"
PORT=8787

# --- Vercel / productie ---
# Postgres met gepoolde verbinding (bv. Neon via de Vercel Marketplace)
# DATABASE_URL=postgres://...-pooler.../mep?sslmode=require
# Foto's: Vercel Blob (maak een Blob store aan in het Vercel-project)
# BLOB_READ_WRITE_TOKEN=
# E-mail (inloglinks): Resend, met een geverifieerd afzenderdomein
# RESEND_API_KEY=
# ADMIN_URL=https://beheer.jouwdomein.nl
# Lokaal zonder Blob: foto's gaan naar deze map
MEDIA_DIR=.media
